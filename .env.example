# Example environment variables for local development
# Frontend -> local API server:
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key

# Local server settings
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Local Postgres example (used by server.js)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/demographic
PGDATABASE=demographic
PGHOST=localhost
PGPASSWORD=postgres
PGPORT=5432
PGUSER=postgres
PG_CONNECTION_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_POOL_MAX=10
PGSSLMODE=disable
PG_SSL_REJECT_UNAUTHORIZED=false

# Optional backend Supabase settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_INVITE_REDIRECT_URL=http://localhost:5173/dashboard

# Production database on Vercel:
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# PGSSLMODE=require
