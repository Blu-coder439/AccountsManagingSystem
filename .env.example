# Example environment variables for local development
# Local frontend -> local Express server:
VITE_API_URL=http://localhost:3000

# Production frontend -> deployed backend:
# VITE_API_URL=https://your-api.example.com

# Optional: example Postgres connection (used by server.js)
# Example Supabase / PgBouncer connection (replace [YOUR-PASSWORD]):
# DATABASE_URL=postgresql://postgres.jpuqopyiatzpxwrsygyz:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# If using a production Supabase DB, don't check credentials into source control.
# Set the actual value in your deployment platform's secret store or in a local
# `.env` file (never commit the real `.env`).